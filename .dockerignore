# Node modules (will be reinstalled inside container)
node_modules

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# dotenv env files
.env
.env.*  # only include if you're copying a specific one in Dockerfile

# Editor directories and files
.vscode
.idea
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# Test files
__tests__
coverage
*.spec.ts
*.test.ts

# Build outputs
.next
dist

# Dockerfile itself if you don't want to copy it in
Dockerfile
docker-compose.yml

# Prisma generated output if you don't need to copy it
prisma/dev.db
