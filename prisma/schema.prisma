generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS
enum GameStatus {
  SCHEDULED
  IN_PROGRESS
  FINAL
  POSTPONED
}

enum PitcherDecision {
  WIN
  LOSS
  SAVE
  HOLD
  NO_DECISION
}

// MODELS
model Season {
  id                        Int                         @id @default(autoincrement())
  year                      Int
  startDate                 DateTime
  endDate                   DateTime
  TeamRecord                TeamRecord[]
  TeamELO                   TeamELO[]
  PlayerSeasonBattingStats  PlayerSeasonBattingStats[]
  TeamSeasonBattingStats    TeamSeasonBattingStats[]
  TeamSeasonPitchingStats   TeamSeasonPitchingStats[]
  TeamSeasonFieldingStats   TeamSeasonFieldingStats[]
  PlayerSeasonPitchingStats PlayerSeasonPitchingStats[]

  @@unique([year])
}

model Team {
  id           Int    @id @default(autoincrement())
  mlb_api_id   Int    @unique
  venue_id     Int?
  city         String @db.VarChar(100)
  name         String @db.VarChar(100)
  abbreviation String @unique
  logo_url     String @db.VarChar(255)

  homeGames               Game[]                    @relation("HomeTeam")
  awayGames               Game[]                    @relation("AwayTeam")
  players                 Player[]
  TeamGameBattingStats    TeamGameBattingStats[]
  TeamGamePitchingStats   TeamGamePitchingStats[]
  TeamSeasonBattingStats  TeamSeasonBattingStats[]
  TeamSeasonPitchingStats TeamSeasonPitchingStats[]
  TeamRecord              TeamRecord[]
  TeamELO                 TeamELO[]
  TeamGameFieldingStats   TeamGameFieldingStats[]
  TeamSeasonFieldingStats TeamSeasonFieldingStats[]
}

model Game {
  id                    Int        @id @default(autoincrement())
  mlb_api_id            Int?       @unique
  espn_api_id           Int?       @unique
  season_id             Int
  venue_id              Int?
  venue                 Venue?     @relation(fields: [venue_id], references: [id])
  date                  DateTime
  status                GameStatus
  isPostseason          Boolean    @default(false)
  isNeutralSite         Boolean    @default(false)
  homeTeamId            Int
  awayTeamId            Int
  homeTeam              Team       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam              Team       @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore             Int?
  awayScore             Int?
  winningTeamId         Int?
  startingPitcherHomeId Int?
  startingPitcherAwayId Int?
  homeStartingPitcher   Player?    @relation("HomePitcher", fields: [startingPitcherHomeId], references: [id])
  awayStartingPitcher   Player?    @relation("AwayPitcher", fields: [startingPitcherAwayId], references: [id])
  // Lineups
  battingOrderHome      Int[] // Array of player IDs or names
  battingOrderAway      Int[]

  Weather                 Weather?
  PlayerGameBattingStats  PlayerGameBattingStats[]
  PlayerGamePitchingStats PlayerGamePitchingStats[]
  InningDetails           InningDetails[]
  TeamGameBattingStats    TeamGameBattingStats[]
  TeamGamePitchingStats   TeamGamePitchingStats[]
  TeamGameFieldingStats   TeamGameFieldingStats[]
  GameOdds                GameOdds?

  @@index(date)
  @@index(homeTeamId)
  @@index(awayTeamId)
  @@index([season_id, date]) // Faster queries for games in a season, sorted by date
}

model Player {
  id            Int    @id @default(autoincrement())
  mlb_api_id    Int?   @unique
  firstName     String @db.VarChar(100)
  lastName      String @db.VarChar(100)
  position      String @db.VarChar(100) // e.g., "Pitcher", "Catcher", "First Base", etc.
  uniformNumber Int?
  photoUrl      String @db.VarChar(255)
  teamId        Int?

  team                      Team?                       @relation(fields: [teamId], references: [id])
  Injury                    Injury[]
  PlayerGameBattingStats    PlayerGameBattingStats[]
  PlayerGamePitchingStats   PlayerGamePitchingStats[]
  PlayerSeasonBattingStats  PlayerSeasonBattingStats[]
  PlayerSeasonPitchingStats PlayerSeasonPitchingStats[]
  homeGamesPitched          Game[]                      @relation("HomePitcher")
  awayGamesPitched          Game[]                      @relation("AwayPitcher")

  @@index([teamId, lastName])
}

model PlayerGameBattingStats {
  playerId Int
  gameId   Int
  player   Player @relation(fields: [playerId], references: [id])
  game     Game   @relation(fields: [gameId], references: [id])

  summary              String
  flyOuts              Int
  groundOuts           Int
  airOuts              Int
  runs                 Int
  doubles              Int
  triples              Int
  homeRuns             Int
  strikeOuts           Int
  baseOnBalls          Int
  intentionalWalks     Int
  hits                 Int
  hitByPitch           Int
  atBats               Int
  caughtStealing       Int
  stolenBases          Int
  groundIntoDoublePlay Int
  groundIntoTriplePlay Int
  plateAppearances     Int
  totalBases           Int
  rbi                  Int
  leftOnBase           Int
  sacBunts             Int
  sacFlies             Int
  catchersInterference Int
  pickoffs             Int
  popOuts              Int
  lineOuts             Int

  @@id([playerId, gameId])
  @@index([playerId, gameId])
}

model PlayerGamePitchingStats {
  playerId Int
  gameId   Int
  player   Player @relation(fields: [playerId], references: [id])
  game     Game   @relation(fields: [gameId], references: [id])

  decision               PitcherDecision?
  summary                String
  gamesPlayed            Int
  gamesStarted           Int
  flyouts                Int
  groundOuts             Int
  airOuts                Int
  runs                   Int
  doubles                Int
  triples                Int
  homeRuns               Int
  strikeOuts             Int
  baseOnBalls            Int
  intentionalWalks       Int
  hits                   Int
  hitByPitch             Int
  atBats                 Int
  caughtStealing         Int
  stolenBases            Int
  numberOfPitches        Int
  inningsPitched         Float
  wins                   Int
  losses                 Int
  saves                  Int
  saveOpporunities       Int
  holds                  Int
  blownSaves             Int
  earnedRuns             Int
  battersFaced           Int
  outs                   Int
  completeGames          Int
  shutouts               Int
  pitchesThrown          Int
  balls                  Int
  strikes                Int
  hitBatsmen             Int
  balks                  Int
  wildPitches            Int
  pickoffs               Int
  rbi                    Int
  gamesFinished          Int
  inheritedRunners       Int
  inheritedRunnersScored Int
  catchersInterference   Int
  sacBunts               Int
  sacFlies               Int
  passedBall             Int
  popOuts                Int
  lineOuts               Int
  pitchingScore          Float?

  @@id([playerId, gameId])
  @@index([playerId, gameId])
}

