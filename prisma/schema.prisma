generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS
enum SportType {
  BASEBALL
  BASKETBALL
}

enum BattingHand {
  LEFT
  RIGHT
  SWITCH
}

enum ThrowingHand {
  LEFT
  RIGHT
  SWITCH
}

enum GameStatus {
  SCHEDULED
  IN_PROGRESS
  FINAL
  POSTPONED
  CANCELED
}

enum GameType {
  R // Regular Season
  S // Spring Training
  E // Exhibition
  P // Postseason
  A // All-Star Game
}

enum PitcherDecision {
  WIN
  LOSS
  SAVE
  HOLD
  NONE
}

// MODELS
model League {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(100)
  sport        SportType
  abbreviation String       @unique @db.VarChar(10)
  conferences  Conference[]
  divisions    Division[]
  games        Game[]
  teams        Team[]
  seasons      Season[]

  @@map("leagues")
}

model Conference {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(100)
  short_name String     @db.VarChar(50)
  league_id  Int
  league     League     @relation(fields: [league_id], references: [id], onDelete: Cascade)
  divisions  Division[]
  teams      Team[]

  @@map("conferences")
}

model Division {
  id            Int        @id @default(autoincrement())
  name          String     @db.VarChar(100)
  short_name    String     @db.VarChar(50)
  league_id     Int
  conference_id Int
  conference    Conference @relation(fields: [conference_id], references: [id], onDelete: Cascade)
  league        League     @relation(fields: [league_id], references: [id], onDelete: Cascade)
  teams         Team[]

  @@map("divisions")
}

model Season {
  id        Int      @id @default(autoincrement())
  leagueId  Int
  year      Int
  startDate DateTime
  endDate   DateTime

  league     League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  games      Game[]
  TeamRecord TeamRecord[]

  @@unique([leagueId, year])
  @@map("seasons")
}

model Game {
  id              Int        @id @default(autoincrement())
  mlb_api_id      Int?       @unique
  league_id       Int
  season_id       Int
  home_team_id    Int
  away_team_id    Int
  venue_id        Int
  game_type       GameType
  game_date       DateTime   @db.Date
  game_status     GameStatus
  is_neutral_site Boolean    @default(false)
  home_score      Int?
  away_score      Int?
  winner_team_id  Int?

  league           League            @relation(fields: [league_id], references: [id], onDelete: Cascade)
  season           Season            @relation(fields: [season_id], references: [id], onDelete: Cascade)
  away_team        Team              @relation("games_away_team_idToteams", fields: [away_team_id], references: [id], onDelete: Cascade)
  home_team        Team              @relation("games_home_team_idToteams", fields: [home_team_id], references: [id], onDelete: Cascade)
  playerStats      PlayerStats[]
  teamStats        TeamStats[]
  battingOrders    BattingOrder[]
  startingPitchers StartingPitcher[]
  TeamRecord       TeamRecord[]

  @@map("games")
}

model Team {
  id              Int    @id @default(autoincrement())
  mlb_api_id      Int?   @unique
  league_id       Int
  venue_id        Int?
  name            String @db.VarChar(100)
  city            String @db.VarChar(100)
  abbreviation    String @db.VarChar(10)
  logo_url        String @db.VarChar(255)
  conference_id   Int
  division_id     Int
  primary_color   String @db.VarChar(100)
  secondary_color String @db.VarChar(100)

  conference       Conference        @relation(fields: [conference_id], references: [id], onDelete: Cascade)
  division         Division          @relation(fields: [division_id], references: [id], onDelete: Cascade)
  league           League            @relation(fields: [league_id], references: [id], onDelete: Cascade)
  away_games       Game[]            @relation("games_away_team_idToteams")
  home_games       Game[]            @relation("games_home_team_idToteams")
  players          Player[]
  teamStats        TeamStats[]
  battingOrders    BattingOrder[]
  startingPitchers StartingPitcher[]
  venue            Venue?            @relation(fields: [venue_id], references: [id], onDelete: SetNull)
  TeamRecord       TeamRecord[]

  @@map("teams")
}

model Position {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(100)
  abbreviation String    @db.VarChar(10)
  pos_number   Int?
  sport        SportType

  players PlayerPosition[]

  @@unique([abbreviation, sport])
  @@map("positions")
}

model Player {
  id            Int           @id @default(autoincrement())
  mlb_person_id Int?          @unique
  firstName     String        @db.VarChar(100)
  lastName      String        @db.VarChar(100)
  birthDate     DateTime      @db.Date
  age           Int?
  birthCity     String        @db.VarChar(100)
  birthState    String        @db.VarChar(100)
  birthCountry  String        @db.VarChar(100)
  height        Int?
  weight        Int?
  debutDate     DateTime?
  uniformNumber Int?
  photoUrl      String        @db.VarChar(255)
  battingHand   BattingHand?
  throwingHand  ThrowingHand?
  teamId        Int?

  team            Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  stats           PlayerStats[]
  batterMatchups  BatterVsPitcherStats[] @relation("batter")
  pitcherMatchups BatterVsPitcherStats[] @relation("pitcher")
  positions       PlayerPosition[]
  injuries        Injury[]
  StartingPitcher StartingPitcher[]
  BattingOrder    BattingOrder[]

  @@map("players")
}

model PlayerPosition {
  id         Int @id @default(autoincrement())
  playerId   Int
  positionId Int

  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([playerId, positionId])
  @@map("player_positions")
}

model PlayerStats {
  id             Int              @id @default(autoincrement())
  playerId       Int
  gameId         Int
  atBats         Int?
  hits           Int?
  runs           Int?
  homeRuns       Int?
  rbis           Int?
  walks          Int?
  strikeouts     Int?
  pitchesThrown  Int?
  inningsPitched Float?
  earnedRuns     Int?
  decision       PitcherDecision?

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("player_stats")
}

model TeamStats {
  id     Int  @id @default(autoincrement())
  teamId Int
  gameId Int
  runs   Int?
  hits   Int?
  errors Int?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("team_stats")
}

model BatterVsPitcherStats {
  id         Int @id @default(autoincrement())
  batterId   Int
  pitcherId  Int
  atBats     Int
  hits       Int
  strikeouts Int
  homeRuns   Int
  rbis       Int

  batter  Player @relation("batter", fields: [batterId], references: [id], onDelete: Cascade)
  pitcher Player @relation("pitcher", fields: [pitcherId], references: [id], onDelete: Cascade)

  @@map("batter_vs_pitcher_stats")
}

model Injury {
  id             Int       @id @default(autoincrement())
  playerId       Int
  status         String    @db.VarChar(100)
  description    String?   @db.Text
  startDate      DateTime
  expectedReturn DateTime?
  resolved       Boolean   @default(false)
  updatedAt      DateTime  @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("injuries")
}

model StartingPitcher {
  id       Int @id @default(autoincrement())
  gameId   Int
  teamId   Int
  playerId Int

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gameId, teamId])
  @@map("starting_pitchers")
}

model BattingOrder {
  id       Int @id @default(autoincrement())
  gameId   Int
  teamId   Int
  playerId Int
  order    Int

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gameId, teamId, order])
  @@map("batting_orders")
}

model Venue {
  id                         Int     @id @default(autoincrement())
  name                       String  @db.VarChar(100)
  mlb_api_id                 Int     @unique
  latitude                   Float
  longitude                  Float
  address                    String  @db.VarChar(255)
  city                       String  @db.VarChar(100)
  state                      String  @db.VarChar(100)
  zip                        String  @db.VarChar(10)
  country                    String  @db.VarChar(100)
  isIndoor                   Boolean @default(false)
  capacity                   Int?
  turfType                   String? @db.VarChar(100)
  leftFieldDistance          Int?
  leftCenterFieldDistance    Int?
  centerFieldDistance        Int?
  rightCenterFieldDistance   Int?
  rightFieldDistance         Int?
  yearOpened                 Int?
  imageUrl                   String? @db.VarChar(255)
  altitude                   Int?
  leftFieldWallHeight        Int?
  LeftCenterFieldWallHeight  Int?
  CenterFieldWallHeight      Int?
  RightCenterFieldWallHeight Int?
  RightFieldWallHeight       Int?
  Team                       Team[]

  @@map("venues")
}

model TeamRecord {
  id       Int   @id @default(autoincrement())
  teamId   Int
  seasonId Int
  gameId   Int
  wins     Int
  losses   Int
  pct      Float

  team   Team   @relation(fields: [teamId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])
  game   Game   @relation(fields: [gameId], references: [id])
}
