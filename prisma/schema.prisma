generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Season {
  id                        Int                         @id @default(autoincrement())
  year                      Int                         @unique
  startDate                 DateTime
  endDate                   DateTime
  PlayerSeasonBattingStats  PlayerSeasonBattingStats[]
  PlayerSeasonPitchingStats PlayerSeasonPitchingStats[]
  TeamELO                   TeamELO[]
  TeamRecord                TeamRecord[]
  TeamSeasonBattingStats    TeamSeasonBattingStats[]
  TeamSeasonFieldingStats   TeamSeasonFieldingStats[]
  TeamSeasonPitchingStats   TeamSeasonPitchingStats[]
}

model Team {
  id                      Int                       @id @default(autoincrement())
  mlb_api_id              Int                       @unique
  venue_id                Int?
  city                    String                    @db.VarChar(100)
  name                    String                    @db.VarChar(100)
  abbreviation            String                    @unique
  logo_url                String                    @db.VarChar(255)
  awayGames               Game[]                    @relation("AwayTeam")
  homeGames               Game[]                    @relation("HomeTeam")
  players                 Player[]
  TeamELO                 TeamELO[]
  TeamGameBattingStats    TeamGameBattingStats[]
  TeamGameFieldingStats   TeamGameFieldingStats[]
  TeamGamePitchingStats   TeamGamePitchingStats[]
  TeamRecord              TeamRecord[]
  TeamSeasonBattingStats  TeamSeasonBattingStats[]
  TeamSeasonFieldingStats TeamSeasonFieldingStats[]
  TeamSeasonPitchingStats TeamSeasonPitchingStats[]
}

model Game {
  id                      Int                       @id @default(autoincrement())
  mlb_api_id              Int?                      @unique
  season_id               Int
  venue_id                Int?
  date                    DateTime
  status                  GameStatus
  homeTeamId              Int
  awayTeamId              Int
  homeScore               Int?
  awayScore               Int?
  winningTeamId           Int?
  startingPitcherHomeId   Int?
  startingPitcherAwayId   Int?
  battingOrderHome        Int[]
  battingOrderAway        Int[]
  isNeutralSite           Boolean                   @default(false)
  isPostseason            Boolean                   @default(false)
  espn_api_id             Int?                      @unique
  awayTeam                Team                      @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeTeam                Team                      @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayStartingPitcher     Player?                   @relation("AwayPitcher", fields: [startingPitcherAwayId], references: [id])
  homeStartingPitcher     Player?                   @relation("HomePitcher", fields: [startingPitcherHomeId], references: [id])
  venue                   Venue?                    @relation(fields: [venue_id], references: [id])
  GameOdds                GameOdds?
  InningDetails           InningDetails[]
  PlayerGameBattingStats  PlayerGameBattingStats[]
  PlayerGamePitchingStats PlayerGamePitchingStats[]
  TeamGameBattingStats    TeamGameBattingStats[]
  TeamGameFieldingStats   TeamGameFieldingStats[]
  TeamGamePitchingStats   TeamGamePitchingStats[]
  Weather                 Weather?

  @@index([date])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([season_id, date])
}

model Player {
  id                        Int                         @id @default(autoincrement())
  mlb_api_id                Int?                        @unique
  firstName                 String                      @db.VarChar(100)
  lastName                  String                      @db.VarChar(100)
  position                  String                      @db.VarChar(100)
  uniformNumber             Int?
  photoUrl                  String                      @db.VarChar(255)
  teamId                    Int?
  awayGamesPitched          Game[]                      @relation("AwayPitcher")
  homeGamesPitched          Game[]                      @relation("HomePitcher")
  Injury                    Injury[]
  team                      Team?                       @relation(fields: [teamId], references: [id])
  PlayerGameBattingStats    PlayerGameBattingStats[]
  PlayerGamePitchingStats   PlayerGamePitchingStats[]
  PlayerSeasonBattingStats  PlayerSeasonBattingStats[]
  PlayerSeasonPitchingStats PlayerSeasonPitchingStats[]

  @@index([teamId, lastName])
}

model PlayerGameBattingStats {
  playerId             Int
  gameId               Int
  summary              String
  flyOuts              Int
  groundOuts           Int
  airOuts              Int
  runs                 Int
  doubles              Int
  triples              Int
  homeRuns             Int
  strikeOuts           Int
  baseOnBalls          Int
  intentionalWalks     Int
  hits                 Int
  hitByPitch           Int
  atBats               Int
  caughtStealing       Int
  stolenBases          Int
  groundIntoDoublePlay Int
  groundIntoTriplePlay Int
  plateAppearances     Int
  totalBases           Int
  rbi                  Int
  leftOnBase           Int
  sacBunts             Int
  sacFlies             Int
  catchersInterference Int
  pickoffs             Int
  popOuts              Int
  lineOuts             Int
  game                 Game   @relation(fields: [gameId], references: [id])
  player               Player @relation(fields: [playerId], references: [id])

  @@id([playerId, gameId])
  @@index([playerId, gameId])
}

model PlayerGamePitchingStats {
  playerId               Int
  gameId                 Int
  decision               PitcherDecision?
  summary                String
  gamesPlayed            Int
  gamesStarted           Int
  flyouts                Int
  groundOuts             Int
  airOuts                Int
  runs                   Int
  doubles                Int
  triples                Int
  homeRuns               Int
  strikeOuts             Int
  baseOnBalls            Int
  intentionalWalks       Int
  hits                   Int
  hitByPitch             Int
  atBats                 Int
  caughtStealing         Int
  stolenBases            Int
  numberOfPitches        Int
  inningsPitched         Float
  wins                   Int
  losses                 Int
  saves                  Int
  saveOpporunities       Int
  holds                  Int
  blownSaves             Int
  earnedRuns             Int
  battersFaced           Int
  outs                   Int
  completeGames          Int
  shutouts               Int
  pitchesThrown          Int
  balls                  Int
  strikes                Int
  hitBatsmen             Int
  balks                  Int
  wildPitches            Int
  pickoffs               Int
  rbi                    Int
  gamesFinished          Int
  inheritedRunners       Int
  inheritedRunnersScored Int
  catchersInterference   Int
  sacBunts               Int
  sacFlies               Int
  passedBall             Int
  popOuts                Int
  lineOuts               Int
  pitchingScore          Float?
  game                   Game             @relation(fields: [gameId], references: [id])
  player                 Player           @relation(fields: [playerId], references: [id])

  @@id([playerId, gameId])
  @@index([playerId, gameId])
}

