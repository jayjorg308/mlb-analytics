model Injury {
  id             Int       @id @default(autoincrement())
  playerId       Int
  status         String    @db.VarChar(100)
  description    String?   @db.Text
  startDate      DateTime
  expectedReturn DateTime?
  resolved       Boolean   @default(false)
  updatedAt      DateTime  @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index(playerId)
}

model Venue {
  id         Int     @id @default(autoincrement())
  name       String  @db.VarChar(100)
  mlb_api_id Int     @unique
  latitude   Decimal
  longitude  Decimal
  address    String  @db.VarChar(255)
  city       String  @db.VarChar(100)
  state      String  @db.VarChar(100)
  country    String  @db.VarChar(100)
  isIndoor   Boolean @default(false)
  games      Game[]
}

model Weather {
  id              Int     @id @default(autoincrement())
  gameId          Int     @unique
  game            Game    @relation(fields: [gameId], references: [id])
  lowTemperature  Int?
  highTemperature Int?
  condition       String? @db.VarChar(100)
  windSpeed       Int?
}

model InningDetails {
  gameId     Int
  inning     Int
  homeRuns   Int?
  awayRuns   Int?
  homeHits   Int?
  awayHits   Int?
  homeErrors Int?
  awayErrors Int?
  homeLeftOn Int?
  awayLeftOn Int?

  game Game @relation(fields: [gameId], references: [id])

  @@id([gameId, inning])
}

model TeamRecord {
  id         Int @id @default(autoincrement())
  gameId     Int // The game after which this record is set
  teamId     Int
  seasonId   Int
  wins       Int
  losses     Int
  homeWins   Int
  homeLosses Int
  awayWins   Int
  awayLosses Int

  team   Team   @relation(fields: [teamId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])
  game   Game   @relation(fields: [gameId], references: [id])

  @@unique([teamId, gameId]) // Ensures only one record per team per game
  @@index([seasonId, teamId, gameId]) // Faster lookups
}

model TeamELO {
  id        Int     @id @default(autoincrement())
  gameId    Int // The game after which this record is set
  teamId    Int
  seasonId  Int
  elo       Decimal
  eloChange Decimal

  team   Team   @relation(fields: [teamId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])
  game   Game   @relation(fields: [gameId], references: [id])

  @@unique([teamId, gameId]) // Ensures only one record per team per game
  @@index([seasonId, teamId, gameId]) // Faster lookups
}
