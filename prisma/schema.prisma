model Injury {
  id             Int       @id @default(autoincrement())
  playerId       Int
  status         String    @db.VarChar(100)
  description    String?
  startDate      DateTime
  expectedReturn DateTime?
  resolved       Boolean   @default(false)
  updatedAt      DateTime  @updatedAt
  player         Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

model Venue {
  id                 Int     @id @default(autoincrement())
  name               String  @db.VarChar(100)
  mlb_api_id         Int     @unique
  latitude           Float
  longitude          Float
  address            String  @db.VarChar(255)
  city               String  @db.VarChar(100)
  state              String  @db.VarChar(100)
  country            String  @db.VarChar(100)
  isIndoor           Boolean @default(false)
  hasRetractableRoof Boolean @default(false)
  games              Game[]
}

model Weather {
  id              Int     @id @default(autoincrement())
  gameId          Int     @unique
  lowTemperature  Int?
  highTemperature Int?
  condition       String? @db.VarChar(100)
  windSpeed       Int?
  game            Game    @relation(fields: [gameId], references: [id])
}

model InningDetails {
  gameId     Int
  inning     Int
  homeRuns   Int?
  awayRuns   Int?
  homeHits   Int?
  awayHits   Int?
  homeErrors Int?
  awayErrors Int?
  homeLeftOn Int?
  awayLeftOn Int?
  game       Game @relation(fields: [gameId], references: [id])

  @@id([gameId, inning])
}

model TeamRecord {
  teamId     Int
  seasonId   Int
  wins       Int
  losses     Int
  homeWins   Int
  homeLosses Int
  awayWins   Int
  awayLosses Int
  season     Season @relation(fields: [seasonId], references: [id])
  team       Team   @relation(fields: [teamId], references: [id])

  @@id([teamId, seasonId])
  @@index([teamId, seasonId])
}

model TeamELO {
  teamId    Int
  seasonId  Int
  elo       Float
  eloChange Float
  season    Season @relation(fields: [seasonId], references: [id])
  team      Team   @relation(fields: [teamId], references: [id])

  @@id([teamId, seasonId])
  @@index([teamId, seasonId])
}

model GameOdds {
  id             Int      @id @default(autoincrement())
  gameId         Int      @unique
  homeMoneyline  String
  awayMoneyline  String
  runTotal       Float
  overOdds       Float
  underOdds      Float
  homeSpread     Float
  awaySpread     Float
  homeSpreadOdds Float
  awaySpreadOdds Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  game           Game     @relation(fields: [gameId], references: [id])
}

enum GameStatus {
  SCHEDULED
  IN_PROGRESS
  FINAL
  POSTPONED
}

enum PitcherDecision {
  WIN
  LOSS
  SAVE
  HOLD
  NO_DECISION
}
