generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS
enum GameStatus {
  SCHEDULED
  IN_PROGRESS
  FINAL
  POSTPONED
}

enum PitcherDecision {
  WIN
  LOSS
  SAVE
  HOLD
  NO_DECISION
}

// MODELS
model Season {
  id        Int      @id @default(autoincrement())
  year      Int
  startDate DateTime
  endDate   DateTime

  @@unique([year])
}

model Team {
  id           Int    @id @default(autoincrement())
  mlb_api_id   Int    @unique
  venue_id     Int?
  city         String @db.VarChar(100)
  name         String @db.VarChar(100)
  abbreviation String @unique
  logo_url     String @db.VarChar(255)

  homeGames   Game[]           @relation("HomeTeam")
  awayGames   Game[]           @relation("AwayTeam")
  players     Player[]
  seasonStats TeamSeasonStats?
}

model Game {
  id                    Int               @id @default(autoincrement())
  mlb_api_id            Int?              @unique
  season_id             Int
  venue_id              Int?
  venue                 Venue?            @relation(fields: [venue_id], references: [id])
  date                  DateTime
  status                GameStatus
  homeTeamId            Int
  awayTeamId            Int
  homeTeam              Team              @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam              Team              @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore             Int?
  awayScore             Int?
  winningTeamId         Int?              @unique
  startingPitcherHomeId Int?
  startingPitcherAwayId Int?
  // Lineups
  battingOrderHome      String[] // Array of player IDs or names
  battingOrderAway      String[]
  // Participants
  playerStats           PlayerGameStats[]

  @@index(date)
  @@index(homeTeamId)
  @@index(awayTeamId)
  @@index([season_id, date]) // Faster queries for games in a season, sorted by date
}

model Player {
  id            Int    @id @default(autoincrement())
  mlb_api_id    Int?   @unique
  firstName     String @db.VarChar(100)
  lastName      String @db.VarChar(100)
  position      String @db.VarChar(100) // e.g., "Pitcher", "Catcher", "First Base", etc.
  uniformNumber Int?
  photoUrl      String @db.VarChar(255)
  teamId        Int?

  team        Team?              @relation(fields: [teamId], references: [id])
  seasonStats PlayerSeasonStats?
  recentGames PlayerGameStats[] // last 10 games
  Injury      Injury[]

  @@index([teamId, lastName]) // Fast sorting when listing a team's roster
}

model PlayerGameStats {
  id       Int    @id @default(autoincrement())
  playerId Int
  gameId   Int
  player   Player @relation(fields: [playerId], references: [id])
  game     Game   @relation(fields: [gameId], references: [id])

  // Batting stats
  atBats   Int
  hits     Int
  homeRuns Int
  RBIs     Int

  // Pitching stats
  inningsPitched Float?
  strikeouts     Int?
  earnedRuns     Int?
  decision       PitcherDecision?

  @@index(playerId) // Fast queries for a player's game stats
  @@index(gameId) // Fast queries for a game's player stats
}

model PlayerSeasonStats {
  id          Int    @id @default(autoincrement())
  playerId    Int    @unique
  seasonId    Int    @unique
  player      Player @relation(fields: [playerId], references: [id])
  gamesPlayed Int

  // Batting stats
  atBats   Int
  hits     Int
  homeRuns Int
  RBIs     Int

  // Pitching stats

  @@index(playerId)
  @@index(seasonId)
}

model TeamSeasonStats {
  id          Int  @id @default(autoincrement())
  teamId      Int  @unique
  team        Team @relation(fields: [teamId], references: [id])
  seasonId    Int  @unique
  gamesPlayed Int
  wins        Int
  losses      Int
  homeWins    Int  @default(0)
  homeLosses  Int  @default(0)
  awayWins    Int  @default(0)
  awayLosses  Int  @default(0)
  runsScored  Int
  runsAllowed Int
  // Add any other team-level season stats here

  @@index(teamId)
  @@index(seasonId)
}

model Injury {
  id             Int       @id @default(autoincrement())
  playerId       Int
  status         String    @db.VarChar(100)
  description    String?   @db.Text
  startDate      DateTime
  expectedReturn DateTime?
  resolved       Boolean   @default(false)
  updatedAt      DateTime  @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index(playerId)
}

model Venue {
  id         Int     @id @default(autoincrement())
  name       String  @db.VarChar(100)
  mlb_api_id Int     @unique
  latitude   Decimal
  longitude  Decimal
  address    String  @db.VarChar(255)
  city       String  @db.VarChar(100)
  state      String  @db.VarChar(100)
  country    String  @db.VarChar(100)
  isIndoor   Boolean @default(false)
  games      Game[]
}
